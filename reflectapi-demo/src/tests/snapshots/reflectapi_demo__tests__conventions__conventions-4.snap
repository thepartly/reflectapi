        "operationId": "pets.remove",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "description": "A request or response naming one entity: `{\"identity\": …}`.\n\nFor an entity that can be identified in more than one way, `I` saying\nwhich, such as an enum of an ID or an external code, and for the items of\na bulk write. An entity with one fixed key takes it as a plain field, such\nas `id`, instead.",
                    "type": "object",
                    "title": "reflectapi.identity.Identity<reflectapi_demo.tests.conventions.PetId>",
                    "required": [
                      "identity"
                    ],
                    "properties": {
                      "identity": {
                        "$ref": "#/components/schemas/std.string.String"
                      }
                    }
                  },
                  {
                    "description": "A write of `data` with an `if` clause, whose absence takes the clause's\ndefaults: `{\"if\": {…}, …data}`. The aliases above, such as\n[`InsertOrElse`], name its usual clauses.",
                    "type": "object",
                    "title": "reflectapi.conflict.Conditional<reflectapi.identity.Identity<reflectapi_demo.tests.conventions.PetId>, reflectapi.conflict.matching.IfConflictOnRemove<reflectapi.conflict.actions.AbortOrIgnore>>",
                    "properties": {
                      "if": {
                        "description": "The `if` of a remove: the action when the entity doesn't exist, and the\nedition it must be at, if any.",
                        "type": "object",
                        "title": "reflectapi.conflict.matching.IfConflictOnRemove<reflectapi.conflict.actions.AbortOrIgnore>",
                        "properties": {
                          "matches": {
                            "oneOf": [
                              {
                                "description": "Null",
                                "type": "null"
                              },
                              {
                                "$ref": "#/components/schemas/reflectapi.conflict.matching.EditionMatchCondition"
                              }
                            ]
                          },
                          "not_exists": {
                            "$ref": "#/components/schemas/reflectapi.conflict.actions.AbortOrIgnore"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
