    "/pets.replace-all": {
      "description": "",
      "post": {
        "operationId": "pets.replace-all",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/reflectapi_demo.tests.conventions.PetData"
                  },
                  {
                    "description": "A write of `data` with an `if` clause, whose absence takes the clause's\ndefaults: `{\"if\": {…}, …data}`. The aliases above, such as\n[`InsertOrElse`], name its usual clauses.",
                    "type": "object",
                    "title": "reflectapi.conflict.Conditional<reflectapi_demo.tests.conventions.PetData, reflectapi.conflict.matching.IfConflictOnInsertMany<reflectapi.conflict.actions.ReplaceOrAbort>>",
                    "properties": {
                      "if": {
                        "description": "The `if` of an insert of several entities: the action for each listed\nitem that exists, and what the parent must match, `exists` by default.",
                        "type": "object",
                        "title": "reflectapi.conflict.matching.IfConflictOnInsertMany<reflectapi.conflict.actions.ReplaceOrAbort>",
                        "properties": {
