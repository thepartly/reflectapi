    "/pets.update": {
      "description": "",
      "post": {
        "operationId": "pets.update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/reflectapi_demo.tests.conventions.PetData"
                      },
                      {
                        "description": "An entity's identity beside its data, whose fields are flattened in:\n`{\"identity\": …, \"name\": …}`.\n\nFor the same cases as [`Identity`]; with an `if` clause around it, it is\none item of a bulk write.",
                        "type": "object",
                        "title": "reflectapi.identity.IdentityData<reflectapi_demo.tests.conventions.PetId, reflectapi_demo.tests.conventions.PetData>",
                        "required": [
                          "identity"
                        ],
                        "properties": {
                          "identity": {
                            "$ref": "#/components/schemas/std.string.String"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "description": "A write of `data` whose `if` is required, as is the action in it:\n`{\"if\": {…}, …data}`. A route whose set has no default takes it, through\none of the aliases above, such as [`InsertOrElseRequired`].\n\n```\nuse reflectapi_conventions::conflict::{actions, InsertOrElseRequired, RemoveOrElseRequired};\n\n#[derive(serde::Deserialize, reflectapi::Input)]\nstruct Pet {\nname: String,\n}\n\ntype PetsImport = InsertOrElseRequired<Pet, actions::ReplaceOrIgnore>;\n\nlet insert: PetsImport =\nserde_json::from_str(r#\"{\"if\": {\"exists\": \"ignore\"}, \"name\": \"Rex\"}\"#).unwrap();\nassert_eq!(insert.if_.exists, actions::ReplaceOrIgnore::Ignore);\n\n// Without `if`, refused.\nassert!(serde_json::from_str::<PetsImport>(r#\"{\"name\": \"Rex\"}\"#).is_err());\n\n// A remove that only ignores a missing pet: the client says so.\nlet remove: RemoveOrElseRequired<Pet, actions::Ignore> =\nserde_json::from_str(r#\"{\"if\": {\"not_exists\": \"ignore\"}, \"name\": \"Rex\"}\"#).unwrap();\nassert_eq!(remove.if_.not_exists, actions::Ignore::Ignore);\n```",
                    "type": "object",
                    "title": "reflectapi.conflict.ConditionalRequired<reflectapi.identity.IdentityData<reflectapi_demo.tests.conventions.PetId, reflectapi_demo.tests.conventions.PetData>, reflectapi.conflict.matching.IfConflictOnUpdateRequired<reflectapi.conflict.actions.Ignore>>",
                    "required": [
                      "if"
                    ],
                    "properties": {
                      "if": {
                        "description": "The `if` of [`UpdateOrElseRequired`]: [`IfConflictOnUpdate`] with\n`not_exists` required.",
                        "type": "object",
                        "title": "reflectapi.conflict.matching.IfConflictOnUpdateRequired<reflectapi.conflict.actions.Ignore>",
                        "required": [
                          "not_exists"
                        ],
                        "properties": {
                          "matches": {
                            "oneOf": [
                              {
                                "description": "Null",
                                "type": "null"
                              },
                              {
                                "$ref": "#/components/schemas/reflectapi.conflict.matching.EditionMatchCondition"
                              }
                            ]
                          },
                          "not_exists": {
                            "$ref": "#/components/schemas/reflectapi.conflict.actions.Ignore"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "200 OK",
            "content": {
              "application/json": {
                "schema": {
                  "description": "empty object",
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        }
      }
