    "/pets.insert": {
      "description": "",
      "post": {
        "operationId": "pets.insert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/reflectapi_demo.tests.conventions.PetData"
                      },
                      {
                        "description": "An entity's identity beside its data, whose fields are flattened in:\n`{\"identity\": …, \"name\": …}`.\n\nFor the same cases as [`Identity`]; with an `if` clause around it, it is\none item of a bulk write.",
                        "type": "object",
                        "title": "reflectapi.identity.IdentityData<reflectapi_demo.tests.conventions.PetId, reflectapi_demo.tests.conventions.PetData>",
                        "required": [
                          "identity"
                        ],
                        "properties": {
                          "identity": {
                            "$ref": "#/components/schemas/std.string.String"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "description": "A write of `data` with an `if` clause, whose absence takes the clause's\ndefaults: `{\"if\": {…}, …data}`. The aliases above, such as\n[`InsertOrElse`], name its usual clauses.",
                    "type": "object",
                    "title": "reflectapi.conflict.Conditional<reflectapi.identity.IdentityData<reflectapi_demo.tests.conventions.PetId, reflectapi_demo.tests.conventions.PetData>, reflectapi.conflict.IfConflictOnInsert<reflectapi.conflict.actions.UpdateWithOrAbort<reflectapi_demo.tests.conventions.PetData>>>",
                    "properties": {
                      "if": {
                        "description": "The `if` of an insert, of one entity or several.",
                        "type": "object",
                        "title": "reflectapi.conflict.IfConflictOnInsert<reflectapi.conflict.actions.UpdateWithOrAbort<reflectapi_demo.tests.conventions.PetData>>",
                        "properties": {
                          "exists": {
                            "oneOf": [
                              {
                                "type": "object",
                                "title": "update<reflectapi_demo.tests.conventions.PetData>",
                                "required": [
                                  "update"
                                ],
                                "properties": {
                                  "update": {
                                    "$ref": "#/components/schemas/reflectapi_demo.tests.conventions.PetData"
                                  }
                                }
                              },
                              {
                                "const": "abort"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "200 OK",
            "content": {
              "application/json": {
                "schema": {
                  "description": "A request or response naming one entity: `{\"identity\": …}`.\n\nFor an entity that can be identified in more than one way, `I` saying\nwhich, such as an enum of an ID or an external code, and for the items of\na bulk write. An entity with one fixed key takes it as a plain field, such\nas `id`, instead.",
                  "type": "object",
                  "title": "reflectapi.identity.Identity<reflectapi_demo.tests.conventions.PetId>",
                  "required": [
                    "identity"
                  ],
                  "properties": {
                    "identity": {
                      "$ref": "#/components/schemas/std.string.String"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
