                            "$ref": "#/components/schemas/reflectapi.conflict.actions.ReplaceOrAbort"
                          },
                          "parent_matches": {
                            "$ref": "#/components/schemas/reflectapi.conflict.matching.MatchCondition"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
