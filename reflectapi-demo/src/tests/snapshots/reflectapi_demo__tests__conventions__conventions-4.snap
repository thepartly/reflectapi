                    },
                    "pagination": {
                      "oneOf": [
                        {
                          "description": "Null",
                          "type": "null"
                        },
                        {
                          "description": "Where the next page of a [`ForwardPaginatedList`] starts.",
                          "type": "object",
                          "title": "reflectapi.pagination.ForwardPagination<std.string.String>",
