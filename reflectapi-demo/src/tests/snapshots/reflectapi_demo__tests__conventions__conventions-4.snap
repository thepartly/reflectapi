                  "type": "object",
                  "title": "reflectapi.pagination.ForwardPaginatedList<reflectapi.identity.IdentityData<reflectapi_demo.tests.conventions.PetId, reflectapi_demo.tests.conventions.PetData>, std.string.String>",
                  "required": [
                    "items",
                    "pagination"
                  ],
                  "properties": {
