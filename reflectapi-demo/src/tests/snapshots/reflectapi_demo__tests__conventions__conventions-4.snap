          }
        }
      },
      "std.string.String": {
        "description": "UTF-8 encoded string",
        "type": "string"
      },
      "u32": {
        "description": "32-bit unsigned integer",
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "maximum": 4294967295
      },
      "u64": {
        "description": "64-bit unsigned integer",
        "type": "integer",
        "format": "uint64",
        "minimum": 0
