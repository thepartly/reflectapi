{{!--
  Added to the <head> of every page of the book.

  To verify the site in Google Search Console (URL-prefix property
  https://reflectapi.rs/), paste the verification tag it
  gives below, for example:

  <meta name="google-site-verification" content="...">

  Bing Webmaster Tools can import the site from Search Console instead.
--}}
<link rel="sitemap" type="application/xml" href="{{ path_to_root }}sitemap.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Oxanium:wght@600&display=swap">
{{!--
  The top bar shows reflectapi's wordmark (light and dark images; custom.css
  shows the one for the theme), linking to the landing page, in place of the
  book's title; and the theme
  menu offers two themes: Light, and Dark (mdBook's "coal"). A first visit
  follows the system setting (default-theme and preferred-dark-theme in
  book.toml). custom.css styles the other mdBook themes as one of the two,
  for readers who chose one before.
--}}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    for (const id of ["default_theme", "rust", "navy", "ayu"]) {
      document.getElementById(`mdbook-theme-${id}`)?.closest("li")?.remove();
    }
    const dark = document.getElementById("mdbook-theme-coal");
    if (dark) dark.textContent = "Dark";

    const title = document.querySelector(".menu-title");
    if (title) {
      const link = document.createElement("a");
      link.href = "{{ path_to_root }}index.html";
      link.className = "brand";
      link.title = "reflectapi home";
      link.innerHTML =
        '<img class="light-logo" src="{{ path_to_root }}reflectapi-wordmark.svg" alt="reflectapi">' +
        '<img class="dark-logo" src="{{ path_to_root }}reflectapi-wordmark-dark.svg" alt="reflectapi">';
      title.replaceChildren(link);
    }
  });
</script>
{{!--
  Folded blocks (<details>) open for printing, and fold again after.

  A rule of the API design standard closes with its id as code, `[api-...]`:
  the rule's bullet gets the id as its anchor and the id becomes a link to
  it, so a rule can be linked (design/standard.html#api-method-post-for-writes).
  A rule named elsewhere on the page by its id links to it too.
--}}
<script>
  addEventListener("beforeprint", () => {
    for (const d of document.querySelectorAll("main details:not([open])")) {
      d.open = true;
      d.dataset.printOpened = "";
    }
  });
  addEventListener("afterprint", () => {
    for (const d of document.querySelectorAll("details[data-print-opened]")) {
      d.open = false;
      delete d.dataset.printOpened;
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    const tag = /^\[(api-[a-z0-9-]+)\]$/;
    for (const item of document.querySelectorAll("main li")) {
      const statement = item.querySelector(":scope > p") || item;
      const spans = statement.querySelectorAll(":scope > code");
      const last = spans[spans.length - 1];
      const found = last && tag.exec(last.textContent);
      if (!found || document.getElementById(found[1])) continue;
      item.id = found[1];
      const link = document.createElement("a");
      link.href = "#" + found[1];
      link.className = "rule-tag";
      link.title = "Link to this rule";
      last.textContent = found[1];
      last.replaceWith(link);
      link.appendChild(last);
    }
    for (const span of document.querySelectorAll("main code")) {
      if (span.closest("a") || !document.getElementById(span.textContent)) continue;
      if (!/^api-[a-z0-9-]+$/.test(span.textContent)) continue;
      const link = document.createElement("a");
      link.href = "#" + span.textContent;
      link.className = "rule-tag";
      span.replaceWith(link);
      link.appendChild(span);
    }
    // The page was scrolled before the anchors were there. A rule inside a
    // folded block is unfolded first.
    const wanted = decodeURIComponent(location.hash.slice(1));
    const target = wanted && document.getElementById(wanted);
    if (target) {
      for (let d = target.closest("details"); d; d = d.parentElement.closest("details")) d.open = true;
      target.scrollIntoView();
    }
  });
</script>
{{!--
  Renders ```mermaid code blocks as diagrams, in the book's silver palette,
  light or dark to match the book's theme. A module script runs after the page is
  parsed, so the code blocks exist by then.
--}}
<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs";

  const dark = ["coal", "navy", "ayu"].some((theme) =>
    document.documentElement.classList.contains(theme),
  );
  const font = '"Geist", "Helvetica Neue", Arial, sans-serif';
  mermaid.initialize({
    startOnLoad: false,
    theme: "base",
    themeVariables: dark
      ? { darkMode: true, background: "#131414", primaryColor: "#1B1C1C",
          primaryTextColor: "#F7F7F7", primaryBorderColor: "#6E6F70",
          lineColor: "#B2B5B6", secondaryColor: "#494B4D",
          tertiaryColor: "#1B1C1C", edgeLabelBackground: "#131414", fontFamily: font }
      : { background: "#FFFFFF", primaryColor: "#F7F7F7",
          primaryTextColor: "#131414", primaryBorderColor: "#B2B5B6",
          lineColor: "#6E6F70", secondaryColor: "#FFFFFF",
          tertiaryColor: "#F7F7F7", edgeLabelBackground: "#FFFFFF", fontFamily: font },
  });

  const diagrams = [];
  for (const code of document.querySelectorAll("pre > code.language-mermaid")) {
    const diagram = document.createElement("pre");
    diagram.className = "mermaid";
    diagram.textContent = code.textContent;
    code.parentElement.replaceWith(diagram);
    diagrams.push(diagram);
  }
  if (diagrams.length > 0) {
    // Mermaid sizes each box by measuring its text, so wait for the book's
    // font: measured in the fallback font, Geist's wider text overflows.
    // `fonts.ready` alone resolves at once if Geist hasn't started loading,
    // so ask for it; a failed load leaves the fallback, which still fits.
    await document.fonts.load('16px "Geist"').catch(() => {});
    await document.fonts.ready;
    await mermaid.run({ nodes: diagrams });
  }
</script>
